{
  "schemaVersion": 1,
  "id": "volytrafly",
  "version": "${version}",
  "name": "Volytra Fly",
  "description": "A Meteor Client addon specifically designed to maximise the flight envelope of elytra flight on 6b6t along with providing new quality-of-life features.",
  "authors": [
    "Volizray"
  ],
  "contact": {
    "sources": "https://github.com/Volizray/VolytraFly-Addon"
  },
  "icon": "assets/volytrafly/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.volytrafly.VolytraFlyAddon"
    ]
  },
  "mixins": [
    "volytrafly.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=25",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
